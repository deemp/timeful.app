# Root test environment for isolated browser and Mongo-backed tests.

# Isolated browser E2E network
E2E_VITE_HOST=127.0.0.1
E2E_VITE_PORT=4174
E2E_API_HOST=127.0.0.1
E2E_API_PORT=3003
E2E_API_INTERNAL_PORT=3003

# Frontend build-time values
VITE_APP_ENV=test
VITE_POSTHOG_API_KEY=
VITE_POSTHOG_API_HOST=
VITE_ENABLE_SIGN_IN=false
VITE_ENABLE_RICH_LANDING=false
VITE_ENABLE_PRIVACY_POLICY=true
VITE_FEEDBACK_URL=https://github.com/deemp/timeful/issues
VITE_SUPPORT_EMAIL=contact@timeful.fun
VITE_GITHUB_REPO_URL=https://github.com/deemp/timeful

# Backend runtime values
APP_ENV=test
APP_PORT=3003
APP_BASE_URL=http://${E2E_VITE_HOST}:${E2E_VITE_PORT}
SERVER_BIND_HOST=127.0.0.1
CLIENT_ID=
CLIENT_SECRET=
ANDROID_CLIENT_ID=
IOS_CLIENT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MONGODB_URI=mongodb://mongo-test:27017/?serverSelectionTimeoutMS=2000&connectTimeoutMS=2000
MONGODB_DATABASE=timeful-test
POSTGRES_DATABASE=postgres
POSTGRES_TEST_DATABASE=timeful-test-postgres
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_BOOTSTRAP_USERNAME=timeful_postgres_admin
POSTGRES_BOOTSTRAP_PASSWORD=timeful_postgres_admin_password
POSTGRES_MIGRATOR_USERNAME=timeful_migrator
POSTGRES_MIGRATOR_PASSWORD=timeful_migrator_password
POSTGRES_APPLICATION_USERNAME=timeful_app
POSTGRES_APPLICATION_PASSWORD=timeful_app_password
POSTGRES_BACKUP_USERNAME=timeful_backup
POSTGRES_BACKUP_PASSWORD=timeful_backup_password
POSTGRES_MIGRATOR_URI=postgres://timeful_migrator:timeful_migrator_password@postgres:5432/postgres?sslmode=disable
POSTGRES_APPLICATION_URI=postgres://timeful_app:timeful_app_password@postgres-test:5432/timeful-test-postgres?sslmode=disable
POSTGRES_ANONYMOUS_EVENT_CREATION_ENABLED=false
POSTGRES_CONNECT_TIMEOUT_SECONDS=10
POSTGRES_MAX_CONNS=10
ENCRYPTION_KEY=
SESSION_SECRET=01234567890123456789012345678901
CORS_ORIGINS=http://localhost:${E2E_VITE_PORT},http://${E2E_VITE_HOST}:${E2E_VITE_PORT}
SERVICE_ACCOUNT_KEY_PATH=
ANALYTICS_USERNAME=
ANALYTICS_PASSWORD=
DISCORD_BOT_TOKEN=
DISCORD_BOT_CHANNEL=
GUILD_ID=
GOOGLE_CLOUD_PROJECT_ID=timeful
GOOGLE_CLOUD_TASKS_LOCATION=us-central1
GOOGLE_CLOUD_TASKS_QUEUE=SendReminderEmail
SLACK_DEV_WEBHOOK_URL=
SLACK_PROD_WEBHOOK_URL=
MAILCHIMP_API_KEY=
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_LIST_ID=
LISTMONK_ENABLED=false
LISTMONK_URL=
LISTMONK_USERNAME=
LISTMONK_PASSWORD=
LISTMONK_LIST_ID=
LISTMONK_INITIAL_EMAIL_REMINDER_ID=
LISTMONK_SECOND_EMAIL_REMINDER_ID=
LISTMONK_FINAL_EMAIL_REMINDER_ID=
LISTMONK_OTP_EMAIL_TEMPLATE_ID=
LISTMONK_OTP_FROM_ADDRESS=
GMAIL_APP_PASSWORD=
TIMEFUL_EMAIL_ADDRESS=
GIN_MODE=debug

# Remove the test stack and database volumes after E2E. Set true to retain failure state.
TEST_DB_PERSIST=false

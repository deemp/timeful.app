{
  "name": "timeful-e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "inspect": "tsx ./inspect/src/inspect.ts",
    "inspect:landing": "tsx ./inspect/src/inspect.ts --target landing",
    "inspect:route": "tsx ./inspect/src/route-profile.ts",
    "inspect:collector-bisect": "tsx ./inspect/src/collector-bisect.ts",
    "lint": "oxlint . && eslint . --cache --concurrency 1",
    "lint:fix": "oxlint . --fix && eslint . --fix --cache --concurrency 1",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.4.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.78.0",
    "jiti": "^2.7.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "temporal-polyfill": "^1.0.4",
    "tsx": "^4.20.6",
    "typescript": "npm:typescript-native-bridge@^6.0.3-bridge.12.tsgo.7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.0.16"
  },
  "engines": {
    "node": ">=26.5.0"
  }
}

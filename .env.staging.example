# Root staging environment for frontend builds and docker compose.

# Frontend build-time values
VITE_APP_ENV=staging
VITE_POSTHOG_API_KEY=
VITE_POSTHOG_API_HOST=
VITE_ENABLE_SIGN_IN=true
VITE_ENABLE_RICH_LANDING=true
VITE_ENABLE_PRIVACY_POLICY=true
VITE_FEEDBACK_URL=https://github.com/deemp/timeful/issues
VITE_SUPPORT_EMAIL=contact@timeful.fun
VITE_GITHUB_REPO_URL=https://github.com/deemp/timeful

# Optional local preview settings for staging-style frontend checks
VITE_PREVIEW_HOST=127.0.0.1
VITE_PREVIEW_PORT=4173

# Backend runtime values
APP_ENV=staging
APP_PORT=3004
APP_BASE_URL=https://staging.timeful.fun
SERVER_BIND_HOST=127.0.0.1
CLIENT_ID=
CLIENT_SECRET=
ANDROID_CLIENT_ID=
IOS_CLIENT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MongoDB credentials are required by compose.staging.yaml. Generate URL-safe
# passwords with: openssl rand -base64 36 | tr -d '\n' | tr '+/' '-_'
MONGODB_ROOT_USERNAME=timeful_staging_root
MONGODB_ROOT_PASSWORD=
MONGODB_APP_USERNAME=timeful_staging_app
MONGODB_APP_PASSWORD=
MONGODB_DATABASE=timeful-staging
# Use the application credentials above; URL encode the password.
MONGODB_URI=
# PostgreSQL passwords must be URL encoded in the role-specific URIs below.
POSTGRES_DATABASE=timeful-postgres-staging
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_BOOTSTRAP_USERNAME=timeful_postgres_admin
POSTGRES_BOOTSTRAP_PASSWORD=
POSTGRES_MIGRATOR_USERNAME=timeful_migrator
POSTGRES_MIGRATOR_PASSWORD=
POSTGRES_APPLICATION_USERNAME=timeful_app
POSTGRES_APPLICATION_PASSWORD=
POSTGRES_BACKUP_USERNAME=timeful_backup
POSTGRES_BACKUP_PASSWORD=
POSTGRES_MIGRATOR_URI=
POSTGRES_APPLICATION_URI=
POSTGRES_CONNECT_TIMEOUT_SECONDS=10
POSTGRES_MAX_CONNS=10
ENCRYPTION_KEY=
SESSION_SECRET=
CORS_ORIGINS=https://www.staging.timeful.fun
SERVICE_ACCOUNT_KEY_PATH=
ANALYTICS_USERNAME=
ANALYTICS_PASSWORD=
DISCORD_BOT_TOKEN=
DISCORD_BOT_CHANNEL=timeful-bot-staging
GUILD_ID=
GOOGLE_CLOUD_PROJECT_ID=timeful
GOOGLE_CLOUD_TASKS_LOCATION=us-central1
GOOGLE_CLOUD_TASKS_QUEUE=SendReminderEmail
SLACK_DEV_WEBHOOK_URL=
SLACK_PROD_WEBHOOK_URL=
MAILCHIMP_API_KEY=
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_LIST_ID=
LISTMONK_ENABLED=
LISTMONK_URL=
LISTMONK_USERNAME=
LISTMONK_PASSWORD=
LISTMONK_LIST_ID=
LISTMONK_INITIAL_EMAIL_REMINDER_ID=
LISTMONK_SECOND_EMAIL_REMINDER_ID=
LISTMONK_FINAL_EMAIL_REMINDER_ID=
LISTMONK_OTP_EMAIL_TEMPLATE_ID=
LISTMONK_OTP_FROM_ADDRESS=Timeful <noreply@timeful.fun>
GMAIL_APP_PASSWORD=
TIMEFUL_EMAIL_ADDRESS=
GIN_MODE=release

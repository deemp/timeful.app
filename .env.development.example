# Root development environment for frontend tooling and docker compose.

# Frontend tooling
VITE_DEV_HOST=127.0.0.1
VITE_DEV_PORT=4173
VITE_API_PROXY_TARGET=http://127.0.0.1:3002
VITE_PREVIEW_HOST=127.0.0.1
VITE_PREVIEW_PORT=4173

# Frontend build-time values
VITE_APP_ENV=development
VITE_POSTHOG_API_KEY=
VITE_POSTHOG_API_HOST=
VITE_ENABLE_SIGN_IN=true
VITE_ENABLE_RICH_LANDING=true
VITE_ENABLE_PRIVACY_POLICY=true
VITE_FEEDBACK_URL=https://github.com/deemp/timeful/issues
VITE_SUPPORT_EMAIL=contact@timeful.fun
VITE_GITHUB_REPO_URL=https://github.com/deemp/timeful

# Backend runtime values
APP_ENV=development
APP_PORT=3002
APP_BASE_URL=http://127.0.0.1:4173
SERVER_BIND_HOST=127.0.0.1
CLIENT_ID=
CLIENT_SECRET=
ANDROID_CLIENT_ID=
IOS_CLIENT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MONGODB_URI=mongodb://mongo:27017
MONGODB_DATABASE=timeful-development
# PostgreSQL uses separate bootstrap, migration, application, and backup roles.
POSTGRES_DATABASE=timeful-postgres-development
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_BOOTSTRAP_USERNAME=timeful_postgres_admin
POSTGRES_BOOTSTRAP_PASSWORD=timeful_postgres_admin_password
POSTGRES_MIGRATOR_USERNAME=timeful_migrator
POSTGRES_MIGRATOR_PASSWORD=timeful_migrator_password
POSTGRES_APPLICATION_USERNAME=timeful_app
POSTGRES_APPLICATION_PASSWORD=timeful_app_password
POSTGRES_BACKUP_USERNAME=timeful_backup
POSTGRES_BACKUP_PASSWORD=timeful_backup_password
POSTGRES_MIGRATOR_URI=postgres://timeful_migrator:timeful_migrator_password@postgres:5432/timeful-postgres-development?sslmode=disable
POSTGRES_APPLICATION_URI=postgres://timeful_app:timeful_app_password@postgres:5432/timeful-postgres-development?sslmode=disable
POSTGRES_ANONYMOUS_EVENT_CREATION_ENABLED=false
POSTGRES_CONNECT_TIMEOUT_SECONDS=10
POSTGRES_MAX_CONNS=10
ENCRYPTION_KEY=
SESSION_SECRET=
CORS_ORIGINS=https://localhost,http://localhost:4173,http://127.0.0.1:4173
SERVICE_ACCOUNT_KEY_PATH=
ANALYTICS_USERNAME=
ANALYTICS_PASSWORD=
DISCORD_BOT_TOKEN=
DISCORD_BOT_CHANNEL=timeful-bot-dev
GUILD_ID=
GOOGLE_CLOUD_PROJECT_ID=timeful
GOOGLE_CLOUD_TASKS_LOCATION=us-central1
GOOGLE_CLOUD_TASKS_QUEUE=SendReminderEmail
SLACK_DEV_WEBHOOK_URL=
SLACK_PROD_WEBHOOK_URL=
MAILCHIMP_API_KEY=
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_LIST_ID=
LISTMONK_ENABLED=
LISTMONK_URL=
LISTMONK_USERNAME=
LISTMONK_PASSWORD=
LISTMONK_LIST_ID=
LISTMONK_INITIAL_EMAIL_REMINDER_ID=
LISTMONK_SECOND_EMAIL_REMINDER_ID=
LISTMONK_FINAL_EMAIL_REMINDER_ID=
LISTMONK_OTP_EMAIL_TEMPLATE_ID=
LISTMONK_OTP_FROM_ADDRESS=Timeful <noreply@timeful.fun>
GMAIL_APP_PASSWORD=
TIMEFUL_EMAIL_ADDRESS=
GIN_MODE=debug

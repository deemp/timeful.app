# syntax=docker/dockerfile:1.7

FROM node:26.5.0-bookworm-slim AS deps

WORKDIR /app

COPY package*.json ./
COPY .npmrc ./
RUN --mount=type=cache,target=/root/.npm npm ci

FROM node:26.5.0-bookworm-slim AS builder

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY package*.json ./

COPY . .

ARG VITE_POSTHOG_API_KEY=""
ARG VITE_APP_ENV=""
ARG VITE_GOOGLE_CLIENT_ID=""
ARG VITE_MICROSOFT_CLIENT_ID=""
ARG VITE_ENABLE_SIGN_IN=""
ARG VITE_ENABLE_FREEMIUM=""
ARG VITE_ENABLE_RICH_LANDING=""
ARG VITE_ENABLE_PRIVACY_POLICY=""
ARG VITE_FEEDBACK_URL=""
ARG VITE_SUPPORT_EMAIL=""
ARG VITE_GITHUB_REPO_URL=""

RUN VITE_POSTHOG_API_KEY="$VITE_POSTHOG_API_KEY" \
    VITE_APP_ENV="$VITE_APP_ENV" \
    VITE_GOOGLE_CLIENT_ID="$VITE_GOOGLE_CLIENT_ID" \
    VITE_MICROSOFT_CLIENT_ID="$VITE_MICROSOFT_CLIENT_ID" \
    VITE_ENABLE_SIGN_IN="$VITE_ENABLE_SIGN_IN" \
    VITE_ENABLE_FREEMIUM="$VITE_ENABLE_FREEMIUM" \
    VITE_ENABLE_RICH_LANDING="$VITE_ENABLE_RICH_LANDING" \
    VITE_ENABLE_PRIVACY_POLICY="$VITE_ENABLE_PRIVACY_POLICY" \
    VITE_FEEDBACK_URL="$VITE_FEEDBACK_URL" \
    VITE_SUPPORT_EMAIL="$VITE_SUPPORT_EMAIL" \
    VITE_GITHUB_REPO_URL="$VITE_GITHUB_REPO_URL" \
    npm run build

# Move to /build so it's not hidden by volume mount
RUN mv dist /build

FROM scratch AS dist
COPY --from=builder /build /dist

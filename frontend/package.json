{
  "name": "timeful",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "dev:test": "vite --mode test",
    "build": "vue-tsc -b && vite build --mode production",
    "preview": "vite preview --mode production",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "gen:api": "swagger2openapi ../server/docs/swagger.yaml -o src/types/.swagger-v3.yaml --yaml && openapi-typescript src/types/.swagger-v3.yaml -o src/types/api.ts && rm src/types/.swagger-v3.yaml",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:profile": "vitest run --reporter=verbose",
    "test:unit:timings": "vitest run --reporter=verbose --silent",
    "test:unit:timings:serial": "vitest run --reporter=verbose --silent --pool=forks --maxWorkers=1 --no-file-parallelism",
    "lint": "oxlint src && eslint src --cache --concurrency 1",
    "lint:fix": "oxlint src --fix && eslint src --fix --cache --concurrency 1",
    "fmt": "oxfmt src",
    "fmt:check": "oxfmt --check src"
  },
  "dependencies": {
    "@fontsource/chivo-mono": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@mdi/font": "^7.4.47",
    "@unhead/vue": "^3.4.0",
    "bson-objectid": "^2.0.4",
    "color": "^5.0.3",
    "github-buttons": "^2.33.0",
    "is-ua-webview": "^1.1.2",
    "pinia": "^3.0.4",
    "posthog-js": "^1.422.5",
    "temporal-polyfill": "^1.0.4",
    "vue": "^3.5.38",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^5.3.1",
    "vuedraggable": "^4.1.0",
    "vuetify": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.78.0",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.14.0",
    "jiti": "^2.7.0",
    "openapi-typescript": "^7.4.4",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "swagger2openapi": "^7.0.8",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:typescript-native-bridge@^6.0.3-bridge.12.tsgo.7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.0.16",
    "vite-plugin-vuetify": "^2.0.4",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
